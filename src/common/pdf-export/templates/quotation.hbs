<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Quotation {{quoteNumber}}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background: #fff;
      color: #1e293b;
      font-size: 12px;
      line-height: 1.5;
    }
    .page { padding: 32px 36px; max-width: 800px; margin: 0 auto; }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
      padding-bottom: 18px;
      border-bottom: 3px solid #0284c7;
    }
    .brand h1 {
      font-size: 24px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.5px;
    }
    .brand .location-info {
      font-size: 11px;
      color: #64748b;
      margin-top: 4px;
      line-height: 1.4;
    }
    .doc-meta { text-align: right; }
    .doc-type {
      font-size: 22px;
      font-weight: 800;
      color: #0284c7;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    .doc-number {
      font-size: 14px;
      font-weight: 700;
      color: #0f172a;
      margin-top: 2px;
    }
    .doc-sub {
      font-size: 11px;
      color: #64748b;
    }
    .badge {
      display: inline-block;
      margin-top: 6px;
      padding: 3px 10px;
      border-radius: 9999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      background: #e2e8f0;
      color: #334155;
    }

    /* Parties / Details Grid */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .card {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 12px 16px;
      background: #f8fafc;
    }
    .card-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #64748b;
      font-weight: 700;
      margin-bottom: 6px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 4px;
    }
    .card-title {
      font-size: 14px;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 4px;
    }
    .card-row {
      font-size: 11px;
      color: #475569;
      margin-top: 2px;
    }

    /* Items Table */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    thead th {
      background: #0284c7;
      color: #ffffff;
      padding: 8px 10px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
      text-align: left;
    }
    thead th.num, tbody td.num {
      text-align: right;
    }
    tbody tr:nth-child(even) {
      background: #f8fafc;
    }
    tbody td {
      padding: 8px 10px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 12px;
      color: #334155;
    }
    .item-name {
      font-weight: 600;
      color: #0f172a;
    }
    .item-sku {
      font-size: 10px;
      color: #64748b;
    }

    /* Totals */
    .totals-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 24px;
    }
    .totals-box {
      width: 280px;
      border-top: 1px solid #cbd5e1;
      padding-top: 8px;
    }
    .totals-row {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
      font-size: 12px;
      color: #475569;
    }
    .totals-grand {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      border-top: 2px solid #0f172a;
      margin-top: 6px;
      padding-top: 6px;
    }

    /* Notes */
    .notes-box {
      background: #f8fafc;
      border-left: 4px solid #0284c7;
      border-radius: 4px;
      padding: 10px 14px;
      margin-bottom: 20px;
      font-size: 11px;
      color: #475569;
    }
    .notes-box strong {
      color: #0f172a;
      font-size: 11px;
      display: block;
      margin-bottom: 3px;
    }

    /* Footer */
    .footer {
      border-top: 1px solid #e2e8f0;
      padding-top: 12px;
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="page">
    <!-- Header -->
    <div class="header">
      <div class="brand">
        <h1>{{organizationName}}</h1>
        <div class="location-info">
          {{#if locationName}}<div>{{locationName}}</div>{{/if}}
          {{#if locationAddress}}<div>{{locationAddress}}</div>{{/if}}
          {{#if locationPhone}}<div>Tel: {{locationPhone}}</div>{{/if}}
        </div>
      </div>
      <div class="doc-meta">
        <div class="doc-type">Quotation</div>
        <div class="doc-number">{{quoteNumber}}</div>
        <div class="doc-sub">Version {{versionNumber}}</div>
        <div><span class="badge">{{status}}</span></div>
      </div>
    </div>

    <!-- Parties Grid -->
    <div class="grid-2">
      <div class="card">
        <div class="card-label">Quotation For</div>
        <div class="card-title">{{customerName}}</div>
        {{#if customerPhone}}<div class="card-row">Ph: {{customerPhone}}</div>{{/if}}
        {{#if customerEmail}}<div class="card-row">Email: {{customerEmail}}</div>{{/if}}
        {{#if customerGstin}}<div class="card-row">GSTIN: {{customerGstin}}</div>{{/if}}
        {{#if customerAddress}}<div class="card-row">{{customerAddress}}</div>{{/if}}
      </div>
      <div class="card">
        <div class="card-label">Quotation Details</div>
        <div class="card-row">Date: <strong>{{date}}</strong></div>
        <div class="card-row">Pricing: <strong>Tax Inclusive</strong></div>
        {{#if createdByName}}<div class="card-row">Prepared by: {{createdByName}}</div>{{/if}}
      </div>
    </div>

    <!-- Items Table -->
    <table>
      <thead>
        <tr>
          <th style="width: 32px; text-align: center;">#</th>
          <th>Item Description</th>
          <th class="num" style="width: 50px;">Qty</th>
          <th class="num" style="width: 80px;">Rate (Inc)</th>
          <th class="num" style="width: 60px;">Tax %</th>
          <th class="num" style="width: 80px;">Tax (₹)</th>
          <th class="num" style="width: 90px;">Total (₹)</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
          <tr>
            <td style="text-align: center;">{{this.index}}</td>
            <td>
              <div class="item-name">{{this.name}}</div>
              {{#if this.sku}}<div class="item-sku">SKU: {{this.sku}}</div>{{/if}}
            </td>
            <td class="num">{{this.quantity}}</td>
            <td class="num">{{this.rate}}</td>
            <td class="num">{{this.taxRate}}%</td>
            <td class="num">{{this.taxAmount}}</td>
            <td class="num" style="font-weight: 600;">{{this.lineTotal}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Totals -->
    <div class="totals-wrapper">
      <div class="totals-box">
        <div class="totals-row">
          <span>Taxable Base:</span>
          <span>₹{{subtotal}}</span>
        </div>
        <div class="totals-row">
          <span>Total GST:</span>
          <span>₹{{taxAmount}}</span>
        </div>
        <div class="totals-row totals-grand">
          <span>Grand Total:</span>
          <span>₹{{totalAmount}}</span>
        </div>
      </div>
    </div>

    {{#if notes}}
      <div class="notes-box">
        <strong>Notes &amp; Terms:</strong>
        <div>{{notes}}</div>
      </div>
    {{/if}}

    <div class="footer">
      <div>Generated on {{generatedAt}}</div>
      <div>Thank you for your business!</div>
    </div>
  </div>
</body>
</html>
