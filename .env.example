# PostgreSQL (installed directly on the EC2 host)
# host.docker.internal resolves to the EC2 host from inside the Docker container
# This requires PostgreSQL to be installed on the EC2 itself (not as a container)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=erp
DB_PASS=erp_pass
DB_NAME=core_db
DB_SSL=false

# S3-compatible object storage (Backblaze B2 / Cloudflare R2 / MinIO)
#
# --- Backblaze B2 setup ---
# 1. Create a bucket: backblaze.com → B2 Cloud Storage → Create a Bucket
# 2. Note the endpoint shown on the bucket detail page, e.g.:
#       https://s3.us-west-002.backblazeb2.com
# 3. Create an App Key: B2 → App Keys → Add a New Application Key
#    (set permissions to Read and Write for your bucket)
# 4. Copy the keyID → STORAGE_ACCESS_KEY_ID
#    Copy the applicationKey → STORAGE_SECRET_ACCESS_KEY














STORAGE_ENDPOINT=https://s3.us-west-002.backblazeb2.com
STORAGE_REGION=us-west-002
STORAGE_ACCESS_KEY_ID=your_key_id_here
STORAGE_SECRET_ACCESS_KEY=your_application_key_here
STORAGE_BUCKET=your-bucket-name-here

# Public base URL — only set if the bucket is public.
# B2 format: https://f002.backblazeb2.com/file/<bucket-name>
# Or use a custom domain if configured.
# Leave empty to use presigned GET URLs (works for private buckets).
STORAGE_PUBLIC_URL_BASE=

# Mobile application release storage (Backblaze B2 / Cloudflare R2 / S3-compatible)
# Used only for signed erp-app Android/iOS release artifacts. This should be a
# separate private bucket from normal ERP attachments. Never expose these
# credentials through EXPO_PUBLIC_* or VITE_* variables.
#
# Backblaze B2 endpoint format:
#   https://s3.<region>.backblazeb2.com
# Create an application key restricted to read access for this release bucket.
MOBILE_RELEASE_STORAGE_ENDPOINT=https://s3.your-region.backblazeb2.com
MOBILE_RELEASE_STORAGE_REGION=your-region
MOBILE_RELEASE_STORAGE_ACCESS_KEY_ID=your_bucket_scoped_key_id
MOBILE_RELEASE_STORAGE_SECRET_ACCESS_KEY=your_bucket_scoped_application_key
MOBILE_RELEASE_STORAGE_BUCKET=erp-mobile-releases
MOBILE_RELEASE_STORAGE_KEY_PREFIX=releases/mobile/android/stable
MOBILE_RELEASES_ENABLED=true

# Signed download URLs are generated only after Core APIs authorization.
# Five minutes is sufficient for a browser to begin the download.
MOBILE_RELEASE_DOWNLOAD_URL_EXPIRY_SECONDS=300

# Defaults used by the mobile release endpoints and management UI.
MOBILE_RELEASE_DEFAULT_CHANNEL=stable
MOBILE_RELEASE_MAX_ARTIFACT_SIZE_MB=250

# Mail / SMTP (NodeMailer)
# MAIL_USER and MAIL_PASSWORD are required — the service won't send without them.
# For Gmail: enable 2FA, then generate an App Password at
#   https://myaccount.google.com/apppasswords  (use that as MAIL_PASSWORD)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=your_email@gmail.com

# Centrifugo — real-time WebSocket push notifications
# CENTRIFUGAL_SECRET_KEY: HMAC secret used to sign client connection JWTs (must match Centrifugo token_hmac_secret_key)
# CENTRIFUGAL_API_KEY: HTTP API key for server-side publish calls (X-API-Key header)
# CENTRIFUGAL_API_URL: Base URL of your Centrifugo server (no trailing slash)
CENTRIFUGAL_SECRET_KEY=your_centrifugo_token_hmac_secret_here
CENTRIFUGAL_API_KEY=your_centrifugo_http_api_key_here
CENTRIFUGAL_API_URL=http://localhost:8001

# Clerk authentication
# CLERK_SECRET_KEY: from Clerk dashboard → API Keys → Secret key
# CLERK_JWKS_URL: <your-clerk-instance>/.well-known/jwks.json
#   e.g. https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER: exact Clerk Frontend API URL (without a trailing slash)
# CLERK_AUDIENCE: API audience configured in the Clerk session token, e.g. core-apis
# CLERK_AUTHORIZED_PARTIES: comma-separated trusted web/Electron origins
# CLERK_WEBHOOK_SECRET: from Clerk dashboard → Webhooks → signing secret
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=core-apis
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:47821
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Trusted reverse-proxy hops, used to identify client IPs for rate limiting.
# Set to 1 when production traffic passes through exactly one trusted proxy.
API_TRUST_PROXY_HOPS=0

# Google Gemini — used for chatbot embeddings and answer generation
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant vector database — used for chatbot knowledge-base search
# For local development start the Docker service: docker-compose -f docker-compose.development.yml up qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY is only required for Qdrant Cloud deployments; leave empty for local Docker
QDRANT_API_KEY=
QDRANT_COLLECTION=erp-knowledge
