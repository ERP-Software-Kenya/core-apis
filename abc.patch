+      - 5050:80
+    volumes:
+      - ./docker/tmp/pgadmin:/var/lib/pgadmin
+    environment:
+      PGADMIN_DEFAULT_EMAIL: admin@admin.com
+      PGADMIN_DEFAULT_PASSWORD: postgres
+    depends_on:
+      - postgres
+    networks:
+      - core-network
+
+  rabbitmq:
+    container_name: rabbitmq
+    image: rabbitmq:3.8.27-management-alpine
